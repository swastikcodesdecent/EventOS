rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // STRICT ACCESS CONTROL:
    // Without signing up / logging in with Google, nothing is possible.
    // Every read, query, write, create, update, and delete requires request.auth != null.
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
